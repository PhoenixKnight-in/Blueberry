# Copy to .env and adjust. All vars are prefixed BLUEBERRY_.
# Never commit a real .env -- it holds secrets (see .gitignore).

BLUEBERRY_ENVIRONMENT=development
BLUEBERRY_HTTP_TIMEOUT=10.0

# --- GitHub -----------------------------------------------------------------
# REQUIRED IN PRACTICE. Unauthenticated GitHub allows 60 requests/hour per IP,
# which one active developer exhausts in minutes; a token raises it to 5000.
# Create a fine-grained token with NO scopes -- public repository metadata is
# all this service reads, so the token needs no permissions whatsoever.
# In production inject it as a container/orchestrator secret, not via .env.
# BLUEBERRY_GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
BLUEBERRY_GITHUB_MAX_ATTEMPTS=3
BLUEBERRY_GITHUB_MAX_BACKOFF_SECONDS=8.0

# --- Redis (cache) ----------------------------------------------------------
# The service runs without Redis, just slower and with more API calls.
BLUEBERRY_REDIS_URL=redis://localhost:6379/0
BLUEBERRY_CACHE_ENABLED=true
BLUEBERRY_PYPI_CACHE_TTL=3600
BLUEBERRY_GITHUB_CACHE_TTL=1800
BLUEBERRY_NEGATIVE_CACHE_TTL=300

# --- Postgres (history) -----------------------------------------------------
BLUEBERRY_DATABASE_URL=postgresql+asyncpg://blueberry:blueberry@localhost:5432/blueberry
BLUEBERRY_PERSISTENCE_ENABLED=true
BLUEBERRY_DATABASE_AUTO_CREATE=true

# --- Risk scoring -----------------------------------------------------------
# Weights are tunable per environment without touching any checker code.
# Nested settings use a double underscore:
# BLUEBERRY_RISK__TYPOSQUAT_DISTANCE_1=70
# BLUEBERRY_RISK__REPOSITORY_ARCHIVED=25
# BLUEBERRY_THRESHOLDS__CAUTION_AT=20
# BLUEBERRY_THRESHOLDS__HIGH_RISK_AT=60
